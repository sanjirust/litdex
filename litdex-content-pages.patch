+.docs-markdown { color: var(--color-brand-text-primary); font-size: 0.95rem; line-height: 1.75; }
+.docs-markdown h1 { font-size: 2rem; font-weight: 800; letter-spacing: -0.01em; margin: 0 0 1rem; }
